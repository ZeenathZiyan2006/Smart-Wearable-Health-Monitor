# PulseGuardian AI Environment Variables Template
PROJECT_NAME="PulseGuardian AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="pulseguardian-development-super-secret-key-change-in-production-min32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="pulseguardian"
POSTGRES_PASSWORD="pulseguardian_password"
POSTGRES_DB="pulseguardian_db"
# If DATABASE_URL is set, it overrides the PostgreSQL parameters above.
# Default zero-config portable SQLite for local development (no PostgreSQL installation required):
DATABASE_URL="sqlite:///./pulseguardian.db"
# For production or docker-compose with PostgreSQL container, uncomment:
# DATABASE_URL="postgresql+psycopg2://pulseguardian:pulseguardian_password@localhost:5432/pulseguardian_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# CORS Configuration (comma-separated origins or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:4173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:4173","http://127.0.0.1:8000"]

# Voice Assistance & Multilingual Processing Settings
VOICE_STT_PROVIDER="mock_development" # Options: "mock_development", "local_whisper", "hosted_whisper"
VOICE_TRANSLATION_PROVIDER="mock_development" # Options: "mock_development", "hosted_translation", "local_indictrans"
VOICE_TTS_PROVIDER="mock_development" # Options: "mock_development", "hosted_tts"
VOICE_ENABLE_CONSENT_ENFORCEMENT=True
VOICE_AUDIO_RETENTION_HOURS=0
VOICE_CONFIDENCE_THRESHOLD=0.60
VOICE_LANGUAGE_CONFIDENCE_THRESHOLD=0.50
VOICE_MAX_AUDIO_SIZE_BYTES=10485760 # 10 MB in bytes
VOICE_MAX_AUDIO_DURATION_SECONDS=60.0 # Maximum audio duration in seconds (default 60s)
VOICE_MAX_TRANSLATION_CHARS=5000 # Maximum text translation characters (default 5000)
VOICE_MAX_TTS_CHARS=2000 # Maximum speech synthesis characters (default 2000)
DEFAULT_SYSTEM_LANGUAGE="en"

# Hosted OpenAI Whisper STT Settings (Required when VOICE_STT_PROVIDER="hosted_whisper")
# Do NOT commit actual API keys to source control.
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"

# Local Faster-Whisper STT Settings (Required when VOICE_STT_PROVIDER="local_whisper")
# Requires local pip install of faster-whisper and appropriate CTranslate2 runtime
FASTER_WHISPER_MODEL_SIZE="base" # tiny, base, small, medium, large-v3
FASTER_WHISPER_DEVICE="cpu" # cpu, cuda
FASTER_WHISPER_COMPUTE_TYPE="int8" # int8, float16, float32

# Multilingual Text Translation Settings (Required when VOICE_TRANSLATION_PROVIDER="hosted_translation")
# Can reuse OPENAI_API_KEY if using OpenAI endpoint or custom translation endpoint
TRANSLATION_API_KEY=""
TRANSLATION_API_BASE="https://api.openai.com/v1"
TRANSLATION_MODEL_NAME="gpt-4o-mini"

# Local AI4Bharat IndicTrans2 Settings (Required when VOICE_TRANSLATION_PROVIDER="local_indictrans")
# Requires local pip install of transformers, torch, and IndicTrans2 model checkpoints
INDICTRANS_MODEL_DIR=""

# Text-to-Speech (TTS) Settings (Required when VOICE_TTS_PROVIDER="hosted_tts")
# Can reuse OPENAI_API_KEY if using OpenAI TTS or custom hosted TTS endpoint
TTS_API_KEY=""
TTS_API_BASE="https://api.openai.com/v1"
TTS_MODEL_NAME="tts-1" # tts-1 or tts-1-hd
TTS_DEFAULT_VOICE_GENDER="neutral"

