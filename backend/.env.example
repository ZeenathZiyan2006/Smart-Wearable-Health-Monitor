# PulseGuardian AI Environment Variables Template
PROJECT_NAME="PulseGuardian AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="pulseguardian-development-super-secret-key-change-in-production-min32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="pulseguardian"
POSTGRES_PASSWORD="pulseguardian_password"
POSTGRES_DB="pulseguardian_db"
# If DATABASE_URL is set, it overrides the PostgreSQL parameters above.
# Set DATABASE_URL="sqlite:///./pulseguardian.db" for quick local development without Docker.
DATABASE_URL="postgresql+psycopg2://pulseguardian:pulseguardian_password@localhost:5432/pulseguardian_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# CORS Configuration (comma-separated origins or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
